# Python cache and artifacts
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

# Local logs and temp files
*.log
*.tmp
*.bak

# NetRecon generated reports
output/cli/*.txt
output/json/*.json
output/html/*.html

# Keep folder structure
!output/cli/.gitkeep
!output/json/.gitkeep
!output/html/.gitkeep
